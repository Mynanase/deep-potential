# ============================================================
# Deep Potential (JAX) - Environment Variables
# ============================================================
# This file documents optional external overrides. The Python project does not
# automatically load .env; export values through fish, Conda, a container, or a
# scheduler when an override is needed.

# --- JAX Platform ------------------------------------------------
# Force CPU backend (fast compilation, no GPU required).
# Useful for local debugging on MacBook or when GPU is unavailable.
# JAX_PLATFORM_NAME=cpu

# --- GPU Memory ---------------------------------------------------
# Experiment entry points already default this to false before importing JAX.
# Override only when a particular environment needs preallocation.
# XLA_PYTHON_CLIENT_PREALLOCATE=true

# --- XLA Debugging ------------------------------------------------
# Show XLA compilation logs (verbose; only for deep debugging).
# XLA_FLAGS="--xla_dump_to=/tmp/xla_dump"
